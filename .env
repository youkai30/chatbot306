# إعدادات النظام الآمنة
# لا تشارك هذا الملف مع أحد!

# DeepSeek AI
DEEPSEEK_API_KEY=sk-b4cd1b9ec43244b1ad5e9ecbead691ce
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=1000
DEEPSEEK_TEMPERATURE=0.7

# قاعدة البيانات
DATABASE_URL=sqlite:///chatbot_data.db
AUTH_DATABASE_URL=sqlite:///auth.db

# الأمان
SECRET_KEY=your-super-secret-key-change-this-in-production-2024
JWT_SECRET_KEY=jwt-secret-key-very-secure-2024
SESSION_TIMEOUT=3600

# الخادم
HOST=localhost
BACKEND_PORT=8001
FRONTEND_PORT=8000
DEBUG=true

# CORS (المواقع المسموح لها بالوصول)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_DIRECTORY=backups

# Admin User (سيتم إنشاؤه تلقائياً)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=SecureAdmin123!
DEFAULT_ADMIN_EMAIL=admin@chatbot.local
